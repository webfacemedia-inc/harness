webfacedesk.app, www.webfacedesk.app {
	encode zstd gzip
	# storefront API (deskapi) — checkout, Stripe webhook, order status
	@api path /api/* /checkout /welcome /ops* /oauth/* /auth/*
	handle @api {
		reverse_proxy 127.0.0.1:8095
	}
	root * /srv/desk/site
	try_files {path} {path}.html
	file_server
}
