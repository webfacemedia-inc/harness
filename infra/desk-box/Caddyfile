# webfaCe Desk box front door. One password for the owner (v1); the phone
# route split (conversation/approvals only for paired phones) is owed.
{$DESK_HOST} {
	encode zstd gzip
	# Sign-in lives in deskd (username+password, optional Google). Everything
	# except the sign-in routes asks deskd whether the session cookie is good.
	@public path /login /logout /auth/* /healthz /deskd/billing /sw.js
	handle @public {
		reverse_proxy 127.0.0.1:8090
	}
	@protected not path /login /logout /auth/* /healthz /deskd/billing /sw.js
	forward_auth @protected 127.0.0.1:8090 {
		uri /auth/verify
		copy_headers X-Desk-User X-Desk-Role
		@bad status 401
		handle_response @bad {
			redir https://{http.request.host}/login?next={http.request.uri} 302
		}
	}
	# Google sends the owner back here after consent; deskd stores the token on this box.
	handle /oauth/* {
		reverse_proxy 127.0.0.1:8090
	}
	# Files page + API over the Desk folder (deskd checks the session itself too).
	handle /sw.js {
		reverse_proxy 127.0.0.1:8090
	}
	handle /browser {
		reverse_proxy 127.0.0.1:8090
	}
	handle /profile {
		reverse_proxy 127.0.0.1:8090
	}
	handle /connections* {
		reverse_proxy 127.0.0.1:8090
	}
	handle /files* {
		reverse_proxy 127.0.0.1:8090
	}
	handle /deskd/* {
		reverse_proxy 127.0.0.1:8090
	}
	# The Desk browser, watched and taken over from any window (noVNC).
	handle_path /vnc/* {
		reverse_proxy 127.0.0.1:6080
	}
	# noVNC opens its socket at the root, not under /vnc/.
	handle /websockify {
		reverse_proxy 127.0.0.1:6080
	}
	# The harness itself. Its /api fence pins settings/credentials/host
	# methods to a loopback same-origin call. A PHONE session is proxied with
	# its real Host/Origin, so the fence keeps the settings plane away from
	# it (chat, approvals, browser still work via --trusted-host). An OWNER
	# session presents as loopback and gets everything.
	@phone header X-Desk-Role phone
	handle @phone {
		reverse_proxy 127.0.0.1:3080
	}
	handle {
		reverse_proxy 127.0.0.1:3080 {
			header_up Host 127.0.0.1:3080
			header_up Origin http://127.0.0.1:3080
		}
	}
}

# Extra sites for this box (the demo box also serves webfacedesk.app itself).
import /etc/caddy/conf.d/*.caddy
