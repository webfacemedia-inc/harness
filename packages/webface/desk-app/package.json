{
  "name": "@webface/dsh-desk-app",
  "description": "webfaCe Desk composition bundle: persona, teammates default, browse workspace picker (host + client), Team panel, routines, and the Google connector row",
  "version": "0.1.0",
  "private": true,
  "repository": { "type": "git", "url": "git+https://github.com/webfacemedia-inc/harness.git", "directory": "packages/webface/desk-app" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
