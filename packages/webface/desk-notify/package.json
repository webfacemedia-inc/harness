{
  "name": "@webface/dsh-desk-notify",
  "version": "0.1.0",
  "private": true,
  "description": "webfaCe Desk: tells deskd when a session is waiting on the owner (approval, question, take-the-mouse) so the phone can be notified.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/types/**/*.d.ts"],
  "dependencies": { "@deepseek-ai/schemastery": "workspace:^" },
  "peerDependencies": { "@deepseek-ai/cordis": "workspace:^", "@deepseek-ai/dsh-session": "workspace:^" },
  "devDependencies": { "@deepseek-ai/cordis": "workspace:^", "@deepseek-ai/dsh-session": "workspace:^" }
}
